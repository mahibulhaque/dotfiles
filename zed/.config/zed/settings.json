// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "language_models": {
    "openai_compatible": {
      "CerebrasAI": {
        "api_url": "https://api.cerebras.ai/v1",
        "available_models": [
          {
            "name": "zai-glm-4.6",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context7_api_key": "ctx7sk-e20b782d-219e-4a06-8b87-506264affb00"
      }
    }
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "CerebrasAI",
      "model": "zai-glm-4.6"
    },
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": "never",
    "model_parameters": []
  },
  "disable_ai": false,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": ".ZedMono",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "icon_theme": "Catppuccin Macchiato",
  "ui_font_size": 18.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night"
  }
}
